# Checkpoints are hosted on HuggingFace, not in git
ckpt/
nanojev_ckpt/

# Full datasets are regenerated / downloaded, not committed
# (100-line samples under data/samples/ ARE committed)
data/*.jsonl
!data/samples/

# Rollout trajectories and per-row predictions are too large for git
results/trajectories/
results/*episodes*.jsonl
results/*episodes*.manifest.json
results/*.preds.jsonl
results/journal*.jsonl
results/*.stdout
results/train_log*.jsonl
results/train_v*.log
results/*.log

# Python
__pycache__/
*.pyc
.pytest_cache/

# Local tooling caches
.pip-cache/
.venv/

# Local services, credentials, and generated reproduction outputs
.env
.env.*
!.env.example
.chrome/
.ruff_cache/
datasets/
results/retrieval/
results/v4_browser/
results/recomputed_fusion.json
data/*.splits.json

# rag_eval runtime score caches and reader outputs (regenerable)
rag_eval/*.jsonl
rag_eval/transfer/*.jsonl
